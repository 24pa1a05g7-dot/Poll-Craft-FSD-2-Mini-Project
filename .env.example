# Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME=QuickPulse
APP_URL=http://localhost:3000

# Session Configuration
# Generate a strong 32+ character random string for production
SESSION_SECRET=super-secret-session-key-change-in-production
SESSION_MAX_AGE_MS=86400000

# Database Configuration (PostgreSQL)
# For Render / Supabase / Neon / Hosted PostgreSQL:
# Example: postgres://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/poll_survey_db

# Alternative individual credentials if DATABASE_URL is not set:
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poll_survey_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
