# PollCraft Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME=PollCraft
APP_URL=http://localhost:3000

# Session Configuration
# Generate a strong 32+ character random string for production:
SESSION_SECRET=dev-secret-key-32-chars-long-pollcraft-2026
SESSION_MAX_AGE_MS=86400000

# Database Configuration (Supabase PostgreSQL)
# Get your connection URI from your Supabase Dashboard -> Project Settings -> Database -> Connection String
# Mode 1: Transaction Pooler (Recommended for Render, Port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Mode 2: Session Pooler (Port 5432):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Mode 3: Local SQLite fallback (Leave DATABASE_URL blank or comment it out for local zero-config development)
DATABASE_URL=
DB_DIALECT=sqlite
DB_STORAGE=./data/dev.sqlite
DB_SSL=false

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20
