<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card p-4 p-md-5 border-0 shadow-sm rounded-4 bg-white">
        <div class="d-flex align-items-center gap-2 mb-3">
          <a href="/dashboard" class="btn btn-sm btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left"></i> Dashboard
          </a>
          <span class="badge bg-primary-subtle text-primary border small">Instant Poll Creator</span>
        </div>

        <h1 class="h3 fw-bold text-dark mb-1">Create a New Poll</h1>
        <p class="text-secondary small mb-4">Set up your question, add options, and configure voting permissions.</p>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger py-2 small border-0 mb-4" role="alert">
            <ul class="mb-0 ps-3">
              <% errors.forEach(err => { %>
                <li><%= err %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/polls/new" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="title" class="form-label small fw-semibold text-secondary">Poll Question / Title *</label>
            <input type="text" class="form-control" id="title" name="title" value="<%= formData ? formData.title || '' : '' %>" placeholder="e.g. Which elective course should be offered next semester?" required minlength="3" maxlength="255">
          </div>

          <div class="mb-3">
            <label for="description" class="form-label small fw-semibold text-secondary">Context / Description (Optional)</label>
            <textarea class="form-control" id="description" name="description" rows="3" placeholder="Provide background information or voting instructions..."><%= formData ? formData.description || '' : '' %></textarea>
          </div>

          <div class="row mb-4">
            <div class="col-md-6">
              <label for="category" class="form-label small fw-semibold text-secondary">Category</label>
              <select class="form-select" id="category" name="category">
                <option value="General">General</option>
                <option value="Technology">Technology</option>
                <option value="Academics">Academics</option>
                <option value="Campus Life">Campus Life</option>
                <option value="Lifestyle">Lifestyle</option>
                <option value="Sports">Sports</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="expiresAt" class="form-label small fw-semibold text-secondary">Optional Closing Date & Time</label>
              <input type="datetime-local" class="form-control" id="expiresAt" name="expiresAt">
            </div>
          </div>

          <!-- Poll Options Section -->
          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <label class="form-label small fw-semibold text-secondary m-0">Answer Options (Minimum 2) *</label>
              <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" id="btn-add-poll-option">
                <i class="bi bi-plus-lg me-1"></i> Add Option
              </button>
            </div>

            <div id="poll-options-container">
              <div class="input-group mb-2 poll-option-input-group">
                <span class="input-group-text bg-light text-muted">#1</span>
                <input type="text" name="options[]" class="form-control" placeholder="Option 1" required maxlength="255">
                <button type="button" class="btn btn-outline-danger btn-remove-option" title="Remove option">
                  <i class="bi bi-x-lg"></i>
                </button>
              </div>

              <div class="input-group mb-2 poll-option-input-group">
                <span class="input-group-text bg-light text-muted">#2</span>
                <input type="text" name="options[]" class="form-control" placeholder="Option 2" required maxlength="255">
                <button type="button" class="btn btn-outline-danger btn-remove-option" title="Remove option">
                  <i class="bi bi-x-lg"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Configuration Switches -->
          <div class="p-3 bg-light rounded-3 border mb-4">
            <h6 class="fw-semibold text-dark mb-3">Voting & Privacy Settings</h6>
            <div class="form-check form-switch mb-2">
              <input class="form-check-input" type="checkbox" role="switch" id="isMultipleChoice" name="isMultipleChoice">
              <label class="form-check-label small" for="isMultipleChoice">
                <strong>Allow multiple selections</strong> (Respondents can choose more than one option)
              </label>
            </div>

            <div class="form-check form-switch mb-2">
              <input class="form-check-input" type="checkbox" role="switch" id="isAnonymous" name="isAnonymous" checked>
              <label class="form-check-label small" for="isAnonymous">
                <strong>Allow anonymous votes</strong> (Hashed session audit to prevent duplicate votes without revealing respondent name)
              </label>
            </div>

            <div class="form-check form-switch mb-2">
              <input class="form-check-input" type="checkbox" role="switch" id="requireLogin" name="requireLogin">
              <label class="form-check-label small" for="requireLogin">
                <strong>Require user login</strong> (Only registered accounts can vote)
              </label>
            </div>

            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="isPublic" name="isPublic" checked>
              <label class="form-check-label small" for="isPublic">
                <strong>List in public directory</strong> (Uncheck for link-only unlisted access)
              </label>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a href="/dashboard" class="btn btn-light border px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-medium">
              Publish Poll
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
