<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <!-- Title and Actions -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold text-dark m-0">Explore Community Polls</h1>
      <p class="text-secondary small m-0">Participate in active discussions and discover community opinions.</p>
    </div>
    <% if (isAuthenticated) { %>
      <a href="/polls/new" class="btn btn-primary rounded-pill px-3 py-2 btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Create Instant Poll
      </a>
    <% } %>
  </div>

  <!-- Search & Category Filters -->
  <div class="card p-3 border-0 shadow-sm rounded-4 mb-4 bg-white">
    <form action="/polls" method="GET" class="row g-2 align-items-center">
      <div class="col-md-7">
        <div class="input-group">
          <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
          <input type="text" name="search" value="<%= search %>" class="form-control border-start-0" placeholder="Search polls by title or topic...">
        </div>
      </div>
      <div class="col-md-3">
        <select name="category" class="form-select">
          <option value="All" <%= category === 'All' ? 'selected' : '' %>>All Categories</option>
          <option value="General" <%= category === 'General' ? 'selected' : '' %>>General</option>
          <option value="Technology" <%= category === 'Technology' ? 'selected' : '' %>>Technology</option>
          <option value="Academics" <%= category === 'Academics' ? 'selected' : '' %>>Academics</option>
          <option value="Campus Life" <%= category === 'Campus Life' ? 'selected' : '' %>>Campus Life</option>
          <option value="Lifestyle" <%= category === 'Lifestyle' ? 'selected' : '' %>>Lifestyle</option>
          <option value="Sports" <%= category === 'Sports' ? 'selected' : '' %>>Sports</option>
        </select>
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-secondary rounded-3">Filter</button>
      </div>
    </form>
  </div>

  <!-- Poll Cards Grid -->
  <% if (polls.length === 0) { %>
    <div class="card p-5 text-center border-0 shadow-sm rounded-4">
      <div class="display-6 text-muted mb-3"><i class="bi bi-search"></i></div>
      <h3 class="h5 fw-bold text-dark">No polls matched your criteria</h3>
      <p class="text-secondary small">Try adjusting your search query or selected category.</p>
      <div>
        <a href="/polls" class="btn btn-outline-primary btn-sm rounded-pill px-3">Reset Filters</a>
      </div>
    </div>
  <% } else { %>
    <div class="row g-4 mb-5">
      <% polls.forEach(poll => { %>
        <div class="col-md-4">
          <div class="card card-custom card-hover h-100 p-4 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-light text-primary border small"><%= poll.category %></span>
                <span class="badge <%= poll.isOpen ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %> small">
                  <%= poll.isOpen ? 'Active' : 'Closed' %>
                </span>
              </div>
              <h5 class="fw-bold mb-2">
                <a href="/polls/<%= poll.slug %>" class="text-dark text-decoration-none">
                  <%= poll.title %>
                </a>
              </h5>
              <p class="text-secondary small mb-3">
                <%= poll.description ? (poll.description.length > 90 ? poll.description.slice(0, 90) + '...' : poll.description) : 'No description provided.' %>
              </p>
            </div>

            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
              <span class="small text-muted">
                <i class="bi bi-people me-1"></i> <%= poll.votes ? poll.votes.length : 0 %> votes
              </span>
              <div class="btn-group">
                <a href="/polls/<%= poll.slug %>" class="btn btn-sm btn-primary px-3 rounded-pill">
                  Vote
                </a>
                <a href="/polls/<%= poll.slug %>/results" class="btn btn-sm btn-outline-secondary rounded-pill ms-1" title="View Results">
                  <i class="bi bi-graph-up"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <nav aria-label="Polls page navigation">
        <ul class="pagination justify-content-center">
          <% for (let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= p === currentPage ? 'active' : '' %>">
              <a class="page-link" href="/polls?page=<%= p %>&category=<%= category %>&search=<%= search %>"><%= p %></a>
            </li>
          <% } %>
        </ul>
      </nav>
    <% } %>
  <% } %>
</main>

<%- include('../../layouts/footer') %>
