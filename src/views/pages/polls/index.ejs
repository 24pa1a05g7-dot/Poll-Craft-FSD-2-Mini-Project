<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <!-- Title and Actions -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h4 fw-bold text-dark m-0">Explore Community Polls</h1>
      <p class="text-secondary small m-0">Participate in active discussions and discover community opinions.</p>
    </div>
    <% if (isAuthenticated) { %>
      <a href="/polls/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Create Poll
      </a>
    <% } %>
  </div>

  <!-- Search & Category Filters -->
  <div class="pc-card p-3 mb-4 bg-white">
    <form action="/polls" method="GET" class="row g-2 align-items-center">
      <div class="col-md-7">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
          <input type="text" name="search" value="<%= search %>" class="form-control border-start-0" placeholder="Search polls by title or topic...">
        </div>
      </div>
      <div class="col-md-3">
        <select name="category" class="form-select form-select-sm">
          <option value="All" <%= category === 'All' ? 'selected' : '' %>>All Categories</option>
          <option value="General" <%= category === 'General' ? 'selected' : '' %>>General</option>
          <option value="Technology" <%= category === 'Technology' ? 'selected' : '' %>>Technology</option>
          <option value="Academics" <%= category === 'Academics' ? 'selected' : '' %>>Academics</option>
          <option value="Campus Life" <%= category === 'Campus Life' ? 'selected' : '' %>>Campus Life</option>
          <option value="Lifestyle" <%= category === 'Lifestyle' ? 'selected' : '' %>>Lifestyle</option>
          <option value="Sports" <%= category === 'Sports' ? 'selected' : '' %>>Sports</option>
        </select>
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-subtle btn-sm">Filter</button>
      </div>
    </form>
  </div>

  <!-- Poll Cards Grid -->
  <% if (polls.length === 0) { %>
    <div class="pc-card p-5 text-center text-muted">
      <div class="mb-2"><i class="bi bi-search fs-3 text-secondary"></i></div>
      <h3 class="h6 fw-bold text-dark">No polls matched your search</h3>
      <p class="text-secondary small mb-3">Try adjusting your query or selected category.</p>
      <div>
        <a href="/polls" class="btn btn-subtle btn-sm">Reset Filters</a>
      </div>
    </div>
  <% } else { %>
    <div class="row g-3 mb-4">
      <% polls.forEach(poll => { %>
        <div class="col-md-4">
          <div class="pc-card pc-card-interactive h-100 p-4 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="pc-badge pc-badge-category"><%= poll.category %></span>
                <span class="pc-badge <%= poll.isOpen ? 'pc-badge-active' : 'pc-badge-closed' %>">
                  <%= poll.isOpen ? 'Active' : 'Closed' %>
                </span>
              </div>
              <h5 class="fw-semibold fs-6 mb-2">
                <a href="/polls/<%= poll.slug %>" class="text-dark text-decoration-none">
                  <%= poll.title %>
                </a>
              </h5>
              <p class="text-secondary small mb-3">
                <%= poll.description ? (poll.description.length > 90 ? poll.description.slice(0, 90) + '...' : poll.description) : 'No description provided.' %>
              </p>
            </div>

            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
              <span class="small text-muted">
                <i class="bi bi-people me-1"></i> <%= poll.votes ? poll.votes.length : 0 %> votes
              </span>
              <div class="btn-group">
                <a href="/polls/<%= poll.slug %>" class="btn btn-sm btn-primary">Vote</a>
                <a href="/polls/<%= poll.slug %>/results" class="btn btn-sm btn-subtle ms-1" title="Results">
                  <i class="bi bi-graph-up"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <nav aria-label="Polls page navigation">
        <ul class="pagination pagination-sm justify-content-center">
          <% for (let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= p === currentPage ? 'active' : '' %>">
              <a class="page-link" href="/polls?page=<%= p %>&category=<%= category %>&search=<%= search %>"><%= p %></a>
            </li>
          <% } %>
        </ul>
      </nav>
    <% } %>
  <% } %>
</main>

<%- include('../../layouts/footer') %>
