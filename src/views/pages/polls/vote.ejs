<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="pc-card p-4 p-md-5">
        <!-- Top metadata -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
          <div class="d-flex align-items-center gap-2">
            <span class="pc-badge pc-badge-category"><%= poll.category %></span>
            <span class="pc-badge <%= poll.isOpen ? 'pc-badge-active' : 'pc-badge-closed' %>">
              <%= poll.isOpen ? 'Active Poll' : 'Closed' %>
            </span>
          </div>
          <button class="btn btn-subtle btn-sm btn-copy-link" data-url="<%= appUrl %>/polls/<%= poll.slug %>">
            <i class="bi bi-share me-1"></i> Share Link
          </button>
        </div>

        <h1 class="h4 fw-bold text-dark mb-2"><%= poll.title %></h1>
        <% if (poll.description) { %>
          <p class="text-secondary small mb-4"><%= poll.description %></p>
        <% } %>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger py-2 small border-0 mb-4" role="alert">
            <ul class="mb-0 ps-3">
              <% errors.forEach(err => { %>
                <li><%= err %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <% if (hasVoted) { %>
          <div class="pc-card bg-light p-4 text-center mb-4">
            <i class="bi bi-check-circle-fill text-success fs-2 mb-2"></i>
            <h5 class="fw-bold text-dark mb-1">Your Vote Has Been Recorded</h5>
            <p class="text-secondary small mb-3">You have already submitted your response to this poll.</p>
            <div>
              <a href="/polls/<%= poll.slug %>/results" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-graph-up me-1"></i> View Live Results & Charts
              </a>
            </div>
          </div>
        <% } else if (!poll.isOpen) { %>
          <div class="pc-card bg-light p-4 text-center mb-4">
            <i class="bi bi-lock-fill text-secondary fs-2 mb-2"></i>
            <h5 class="fw-bold text-dark mb-1">Voting is Closed</h5>
            <p class="text-secondary small mb-3">This poll has concluded or reached its expiration deadline.</p>
            <div>
              <a href="/polls/<%= poll.slug %>/results" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-graph-up me-1"></i> View Concluded Results
              </a>
            </div>
          </div>
        <% } else if (poll.requireLogin && !isAuthenticated) { %>
          <div class="pc-card bg-light p-4 text-center mb-4">
            <i class="bi bi-shield-exclamation text-warning fs-2 mb-2"></i>
            <h5 class="fw-bold text-dark mb-1">Authentication Required</h5>
            <p class="text-secondary small mb-3">The organizer requires voters to log in before submitting their vote.</p>
            <div class="d-flex justify-content-center gap-2">
              <a href="/auth/login" class="btn btn-primary btn-sm px-4">Sign In to Vote</a>
              <a href="/auth/register" class="btn btn-subtle btn-sm px-4">Register</a>
            </div>
          </div>
        <% } else { %>
          <!-- Voting Form -->
          <form action="/polls/<%= poll.slug %>/vote" method="POST" class="mb-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-4">
              <div class="small text-muted mb-2 fw-medium">
                <% if (poll.isMultipleChoice) { %>
                  <i class="bi bi-check2-square text-primary me-1"></i> Please select one or more options:
                <% } else { %>
                  <i class="bi bi-record-circle text-primary me-1"></i> Please select one option:
                <% } %>
              </div>

              <div class="d-flex flex-column gap-2">
                <% poll.options.forEach(option => { %>
                  <div class="pc-vote-option p-3 border rounded-3 bg-white d-flex align-items-center">
                    <% if (poll.isMultipleChoice) { %>
                      <input type="checkbox" class="form-check-input poll-option-checkbox me-3 my-0" name="options[]" id="opt-<%= option.id %>" value="<%= option.id %>">
                    <% } else { %>
                      <input type="radio" class="form-check-input poll-option-radio me-3 my-0" name="option" id="opt-<%= option.id %>" value="<%= option.id %>" required>
                    <% } %>
                    <label class="form-check-label fs-6 text-dark w-100 mb-0" for="opt-<%= option.id %>" style="cursor: pointer;">
                      <%= option.optionText %>
                    </label>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
              <button type="submit" class="btn btn-primary px-4 py-2 fw-medium">
                Submit Vote
              </button>
              <a href="/polls/<%= poll.slug %>/results" class="text-decoration-none small text-secondary">
                <i class="bi bi-graph-up me-1"></i> View Live Results without voting
              </a>
            </div>
          </form>
        <% } %>

        <!-- Footer / Privacy Details -->
        <div class="pt-3 border-top text-muted small">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
              <i class="bi bi-person me-1"></i> Created by <%= poll.creator ? poll.creator.name : 'Community User' %>
            </span>
            <span>
              <% if (poll.isAnonymous) { %>
                <i class="bi bi-shield-check text-success me-1"></i> Anonymous response mode
              <% } else { %>
                <i class="bi bi-person-badge text-primary me-1"></i> User-identified vote
              <% } %>
            </span>
          </div>
          <% if (poll.expiresAt) { %>
            <div class="mt-1 text-secondary">
              <i class="bi bi-clock me-1"></i> Closes on <%= new Date(poll.expiresAt).toLocaleString() %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const optionCards = document.querySelectorAll('.pc-vote-option');
    function updateHighlights() {
      optionCards.forEach(card => {
        const input = card.querySelector('input');
        if (input && input.checked) {
          card.classList.add('pc-option-selected');
        } else {
          card.classList.remove('pc-option-selected');
        }
      });
    }

    optionCards.forEach(card => {
      const input = card.querySelector('input');
      card.addEventListener('click', (e) => {
        if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'LABEL') {
          if (input.type === 'radio') {
            input.checked = true;
          } else if (input.type === 'checkbox') {
            input.checked = !input.checked;
          }
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
      if (input) {
        input.addEventListener('change', updateHighlights);
      }
    });

    updateHighlights();
  });
</script>

<%- include('../../layouts/footer') %>
