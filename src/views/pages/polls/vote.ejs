<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="card p-4 p-md-5 border-0 shadow-sm rounded-4 bg-white">
        <!-- Top metadata -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-primary border"><%= poll.category %></span>
            <span class="badge <%= poll.isOpen ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %>">
              <%= poll.isOpen ? 'Active Poll' : 'Closed' %>
            </span>
          </div>
          <button class="btn btn-outline-secondary btn-sm rounded-pill btn-copy-link" data-url="<%= appUrl %>/polls/<%= poll.slug %>">
            <i class="bi bi-share me-1"></i> Share Link
          </button>
        </div>

        <h1 class="h3 fw-bold text-dark mb-2"><%= poll.title %></h1>
        <% if (poll.description) { %>
          <p class="text-secondary mb-4"><%= poll.description %></p>
        <% } %>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger py-2 small border-0 mb-4" role="alert">
            <ul class="mb-0 ps-3">
              <% errors.forEach(err => { %>
                <li><%= err %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <% if (hasVoted) { %>
          <div class="card bg-success-subtle border-0 p-4 text-center rounded-3 mb-4">
            <i class="bi bi-check-circle-fill text-success display-6 mb-2"></i>
            <h5 class="fw-bold text-success mb-1">Your Vote Has Been Recorded!</h5>
            <p class="text-secondary small mb-3">You have already submitted your response to this poll.</p>
            <div>
              <a href="/polls/<%= poll.slug %>/results" class="btn btn-success text-white px-4 rounded-pill">
                <i class="bi bi-graph-up me-1"></i> View Live Results & Charts
              </a>
            </div>
          </div>
        <% } else if (!poll.isOpen) { %>
          <div class="card bg-secondary-subtle border-0 p-4 text-center rounded-3 mb-4">
            <i class="bi bi-lock-fill text-secondary display-6 mb-2"></i>
            <h5 class="fw-bold text-dark mb-1">Voting is Closed</h5>
            <p class="text-secondary small mb-3">This poll has concluded or reached its expiration deadline.</p>
            <div>
              <a href="/polls/<%= poll.slug %>/results" class="btn btn-primary px-4 rounded-pill">
                <i class="bi bi-graph-up me-1"></i> View Concluded Results
              </a>
            </div>
          </div>
        <% } else if (poll.requireLogin && !isAuthenticated) { %>
          <div class="card bg-warning-subtle border-0 p-4 text-center rounded-3 mb-4">
            <i class="bi bi-shield-exclamation text-warning display-6 mb-2"></i>
            <h5 class="fw-bold text-dark mb-1">Authentication Required</h5>
            <p class="text-secondary small mb-3">The organizer requires voters to log in before submitting their vote.</p>
            <div class="d-flex justify-content-center gap-2">
              <a href="/auth/login" class="btn btn-primary px-4 rounded-pill">Sign In to Vote</a>
              <a href="/auth/register" class="btn btn-outline-secondary px-4 rounded-pill">Register</a>
            </div>
          </div>
        <% } else { %>
          <!-- Voting Form -->
          <form action="/polls/<%= poll.slug %>/vote" method="POST" class="mb-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-4">
              <div class="small text-muted mb-2">
                <% if (poll.isMultipleChoice) { %>
                  <i class="bi bi-check2-all me-1"></i> You may select one or more options:
                <% } else { %>
                  <i class="bi bi-ui-radios me-1"></i> Please select one option:
                <% } %>
              </div>

              <div class="d-flex flex-column gap-2">
                <% poll.options.forEach(option => { %>
                  <div>
                    <% if (poll.isMultipleChoice) { %>
                      <input type="checkbox" class="btn-check poll-option-checkbox" name="options[]" id="opt-<%= option.id %>" value="<%= option.id %>">
                    <% } else { %>
                      <input type="radio" class="btn-check poll-option-radio" name="option" id="opt-<%= option.id %>" value="<%= option.id %>" required>
                    <% } %>
                    <label class="poll-option-label" for="opt-<%= option.id %>">
                      <div class="d-flex align-items-center">
                        <i class="bi <%= poll.isMultipleChoice ? 'bi-square' : 'bi-circle' %> me-3 text-secondary"></i>
                        <span class="fs-6"><%= option.optionText %></span>
                      </div>
                    </label>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
              <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-medium">
                Submit Vote
              </button>
              <a href="/polls/<%= poll.slug %>/results" class="text-decoration-none small text-secondary">
                <i class="bi bi-graph-up me-1"></i> View Live Results without voting
              </a>
            </div>
          </form>
        <% } %>

        <!-- Footer / Privacy Details -->
        <div class="pt-3 border-top text-muted small">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
              <i class="bi bi-person me-1"></i> Created by <%= poll.creator ? poll.creator.name : 'Community User' %>
            </span>
            <span>
              <% if (poll.isAnonymous) { %>
                <i class="bi bi-shield-check text-success me-1"></i> Anonymous response mode
              <% } else { %>
                <i class="bi bi-person-badge text-primary me-1"></i> User-identified vote
              <% } %>
            </span>
          </div>
          <% if (poll.expiresAt) { %>
            <div class="mt-1 text-secondary">
              <i class="bi bi-clock me-1"></i> Closes on <%= new Date(poll.expiresAt).toLocaleString() %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
