<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="pc-card p-4 p-md-5 bg-white">
        <div class="text-center mb-4">
          <div class="pc-brand-icon mx-auto mb-3" style="width: 36px; height: 36px; font-size: 1.1rem;">
            <i class="bi bi-bar-chart-fill"></i>
          </div>
          <h2 class="h5 fw-bold text-dark mb-1">Create an Account</h2>
          <p class="text-secondary small mb-0">Join PollCraft to create polls and surveys.</p>
        </div>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger py-2 small border-0 mb-3" role="alert">
            <ul class="mb-0 ps-3">
              <% errors.forEach(err => { %>
                <li><%= err %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/auth/register" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="name" class="form-label small fw-semibold text-secondary">Full Name</label>
            <input type="text" class="form-control form-control-sm" id="name" name="name" value="<%= formData ? formData.name || '' : '' %>" placeholder="e.g. Alex Rivera" required autofocus minlength="2">
          </div>

          <div class="mb-3">
            <label for="email" class="form-label small fw-semibold text-secondary">Email Address</label>
            <input type="email" class="form-control form-control-sm" id="email" name="email" value="<%= formData ? formData.email || '' : '' %>" placeholder="name@domain.com" required>
          </div>

          <div class="mb-3">
            <label for="password" class="form-label small fw-semibold text-secondary">Password (Min 8 Characters)</label>
            <input type="password" class="form-control form-control-sm" id="password" name="password" placeholder="••••••••" minlength="8" required>
          </div>

          <div class="mb-4">
            <label for="confirmPassword" class="form-label small fw-semibold text-secondary">Confirm Password</label>
            <input type="password" class="form-control form-control-sm" id="confirmPassword" name="confirmPassword" placeholder="••••••••" minlength="8" required>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
            Register Account
          </button>
        </form>

        <div class="text-center small text-secondary">
          Already have an account? <a href="/auth/login" class="text-dark fw-semibold text-decoration-none">Sign In</a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
