<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="pc-card p-4 p-md-5 bg-white">
        <div class="text-center mb-4">
          <div class="pc-brand-icon mx-auto mb-3" style="width: 36px; height: 36px; font-size: 1.1rem;">
            <i class="bi bi-bar-chart-fill"></i>
          </div>
          <h2 class="h5 fw-bold text-dark mb-1">Sign In to PollCraft</h2>
          <p class="text-secondary small mb-0">Access your polls, questionnaires, and analytics.</p>
        </div>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger py-2 small border-0 mb-3" role="alert">
            <ul class="mb-0 ps-3">
              <% errors.forEach(err => { %>
                <li><%= err %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/auth/login" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="email" class="form-label small fw-semibold text-secondary">Email Address</label>
            <input type="email" class="form-control form-control-sm" id="email" name="email" value="<%= formData ? formData.email || '' : '' %>" placeholder="name@domain.com" required autofocus>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label small fw-semibold text-secondary">Password</label>
            <input type="password" class="form-control form-control-sm" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password">
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
            Sign In
          </button>
        </form>

       <div class="p-3 bg-light rounded-2 border small mb-3">
        ...
      </div>

        <div class="text-center small text-secondary">
          Don't have an account? <a href="/auth/register" class="text-dark fw-semibold text-decoration-none">Create an account</a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
