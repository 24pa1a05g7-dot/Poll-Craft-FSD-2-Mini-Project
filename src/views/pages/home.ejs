<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<!-- Hero Section -->
<header class="py-5 bg-white border-bottom">
  <div class="container py-4">
    <div class="row align-items-center gy-4">
      <div class="col-lg-7">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-light border text-secondary small fw-medium mb-3">
          <span class="badge bg-primary text-white" style="font-size: 0.65rem;">NEW</span>
          <span>Reliable polling and feedback intelligence</span>
        </div>
        <h1 class="display-5 fw-bold text-dark tracking-tight mb-3" style="line-height: 1.15;">
          Collect feedback, run instant polls, and make confident decisions.
        </h1>
        <p class="lead text-secondary mb-4 fs-6 leading-relaxed" style="max-width: 580px;">
          PollCraft delivers instant single-question ballots and multi-format structured surveys. Built with PostgreSQL, transactional voting safety, and real-time Chart.js analytics.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <a href="/polls" class="btn btn-primary px-4 py-2">
            <i class="bi bi-pie-chart me-1"></i> Browse Public Polls
          </a>
          <a href="/surveys" class="btn btn-subtle px-4 py-2">
            <i class="bi bi-card-checklist me-1"></i> Explore Surveys
          </a>
          <% if (!isAuthenticated) { %>
            <a href="/auth/register" class="btn btn-accent px-4 py-2 ms-md-2">
              Create Account
            </a>
          <% } %>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="pc-card p-4 bg-white">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-semibold text-dark m-0 d-flex align-items-center gap-2">
              <i class="bi bi-activity text-primary"></i> Platform Snapshot
            </h6>
            <span class="badge bg-light text-muted border small">Live</span>
          </div>

          <div class="row g-2">
            <div class="col-6">
              <div class="p-3 bg-light rounded-3 border text-center">
                <div class="pc-stat-value text-dark"><%= stats.totalPolls %></div>
                <div class="pc-stat-label">Polls Hosted</div>
              </div>
            </div>
            <div class="col-6">
              <div class="p-3 bg-light rounded-3 border text-center">
                <div class="pc-stat-value text-dark"><%= stats.totalSurveys %></div>
                <div class="pc-stat-label">Surveys Deployed</div>
              </div>
            </div>
            <div class="col-6">
              <div class="p-3 bg-light rounded-3 border text-center">
                <div class="pc-stat-value text-primary"><%= stats.totalVotes %></div>
                <div class="pc-stat-label">Votes Recorded</div>
              </div>
            </div>
            <div class="col-6">
              <div class="p-3 bg-light rounded-3 border text-center">
                <div class="pc-stat-value text-success"><%= stats.totalResponses %></div>
                <div class="pc-stat-label">Survey Answers</div>
              </div>
            </div>
          </div>

          <div class="mt-3 pt-3 border-top text-center">
            <span class="small text-muted">
              <i class="bi bi-shield-check text-success me-1"></i> Double-voting safeguards and transactional writes active
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Featured Section -->
<main class="container my-5">
  <!-- Featured Polls -->
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h4 fw-bold text-dark m-0">Community Polls</h2>
        <p class="text-muted small m-0">Cast your vote and review real-time participant sentiment.</p>
      </div>
      <a href="/polls" class="btn btn-subtle btn-sm">
        All Polls <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>

    <div class="row g-3">
      <% if (featuredPolls.length === 0) { %>
        <div class="col-12">
          <div class="pc-card p-4 text-center text-muted">No public polls published yet.</div>
        </div>
      <% } else { %>
        <% featuredPolls.forEach(poll => { %>
          <div class="col-md-4">
            <div class="pc-card pc-card-interactive h-100 p-4 d-flex flex-column justify-content-between">
              <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="pc-badge pc-badge-category"><%= poll.category %></span>
                  <span class="pc-badge <%= poll.isOpen ? 'pc-badge-active' : 'pc-badge-closed' %>">
                    <%= poll.isOpen ? 'Active' : 'Closed' %>
                  </span>
                </div>
                <h5 class="fw-semibold fs-6 mb-2">
                  <a href="/polls/<%= poll.slug %>" class="text-dark text-decoration-none">
                    <%= poll.title %>
                  </a>
                </h5>
                <p class="text-secondary small mb-3">
                  <%= poll.description ? (poll.description.length > 90 ? poll.description.slice(0, 90) + '...' : poll.description) : 'No description provided.' %>
                </p>
              </div>
              <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                  <i class="bi bi-people me-1"></i> <%= poll.votes ? poll.votes.length : 0 %> votes
                </span>
                <div class="btn-group">
                  <a href="/polls/<%= poll.slug %>" class="btn btn-sm btn-primary">Vote</a>
                  <a href="/polls/<%= poll.slug %>/results" class="btn btn-sm btn-subtle ms-1" title="Results">
                    <i class="bi bi-graph-up"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Featured Surveys -->
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h4 fw-bold text-dark m-0">Featured Surveys</h2>
        <p class="text-muted small m-0">Participate in comprehensive questionnaires and research studies.</p>
      </div>
      <a href="/surveys" class="btn btn-subtle btn-sm">
        All Surveys <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>

    <div class="row g-3">
      <% if (featuredSurveys.length === 0) { %>
        <div class="col-12">
          <div class="pc-card p-4 text-center text-muted">No public surveys published yet.</div>
        </div>
      <% } else { %>
        <% featuredSurveys.forEach(survey => { %>
          <div class="col-md-4">
            <div class="pc-card pc-card-interactive h-100 p-4 d-flex flex-column justify-content-between">
              <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="pc-badge pc-badge-category"><%= survey.category %></span>
                  <span class="pc-badge <%= survey.isOpen ? 'pc-badge-active' : 'pc-badge-closed' %>">
                    <%= survey.isOpen ? 'Open' : 'Closed' %>
                  </span>
                </div>
                <h5 class="fw-semibold fs-6 mb-2">
                  <a href="/surveys/<%= survey.slug %>" class="text-dark text-decoration-none">
                    <%= survey.title %>
                  </a>
                </h5>
                <p class="text-secondary small mb-3">
                  <%= survey.description ? (survey.description.length > 90 ? survey.description.slice(0, 90) + '...' : survey.description) : 'Structured feedback questionnaire.' %>
                </p>
              </div>
              <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                  <i class="bi bi-card-text me-1"></i> <%= survey.responses ? survey.responses.length : 0 %> responses
                </span>
                <div class="btn-group">
                  <a href="/surveys/<%= survey.slug %>" class="btn btn-sm btn-primary">Respond</a>
                  <a href="/surveys/<%= survey.slug %>/results" class="btn btn-sm btn-subtle ms-1" title="Results">
                    <i class="bi bi-graph-up"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Key Architecture Standards -->
  <div class="py-4">
    <div class="text-center mb-4">
      <h2 class="h5 fw-bold text-dark">Engineered for Academic & Enterprise Data Collection</h2>
      <p class="text-secondary small">Security, transactional reliability, and responsive analytics.</p>
    </div>

    <div class="row g-3">
      <div class="col-md-4">
        <div class="pc-card p-4 h-100">
          <div class="d-inline-flex p-2 rounded-2 bg-light text-primary mb-3">
            <i class="bi bi-graph-up-arrow fs-5"></i>
          </div>
          <h6 class="fw-semibold">Real-Time Data Visualization</h6>
          <p class="text-secondary small mb-0">
            Interactive Chart.js bar and doughnut visualizations computed straight from PostgreSQL relational aggregations without synthetic data.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="pc-card p-4 h-100">
          <div class="d-inline-flex p-2 rounded-2 bg-light text-success mb-3">
            <i class="bi bi-shield-check fs-5"></i>
          </div>
          <h6 class="fw-semibold">Structural Integrity & Safety</h6>
          <p class="text-secondary small mb-0">
            Automated locks prevent survey modification after responses exist. Ballot submissions are executed within database transactions.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="pc-card p-4 h-100">
          <div class="d-inline-flex p-2 rounded-2 bg-light text-warning mb-3">
            <i class="bi bi-file-earmark-spreadsheet fs-5"></i>
          </div>
          <h6 class="fw-semibold">Sanitized CSV Export</h6>
          <p class="text-secondary small mb-0">
            Full response data exported in RFC 4180 format with formula injection defenses for safe analysis in Excel and Python Pandas.
          </p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
