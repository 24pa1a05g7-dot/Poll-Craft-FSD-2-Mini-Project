<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h4 fw-bold text-dark m-0">Explore Public Surveys</h1>
      <p class="text-secondary small m-0">Share your detailed perspectives and review survey findings.</p>
    </div>
    <% if (isAuthenticated) { %>
      <a href="/surveys/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Create Survey
      </a>
    <% } %>
  </div>

  <!-- Search & Category Filters -->
  <div class="pc-card p-3 mb-4 bg-white">
    <form action="/surveys" method="GET" class="row g-2 align-items-center">
      <div class="col-md-7">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
          <input type="text" name="search" value="<%= search %>" class="form-control border-start-0" placeholder="Search surveys by title...">
        </div>
      </div>
      <div class="col-md-3">
        <select name="category" class="form-select form-select-sm">
          <option value="All" <%= category === 'All' ? 'selected' : '' %>>All Categories</option>
          <option value="General" <%= category === 'General' ? 'selected' : '' %>>General</option>
          <option value="Academics" <%= category === 'Academics' ? 'selected' : '' %>>Academics</option>
          <option value="Technology" <%= category === 'Technology' ? 'selected' : '' %>>Technology</option>
          <option value="Campus Life" <%= category === 'Campus Life' ? 'selected' : '' %>>Campus Life</option>
          <option value="Research" <%= category === 'Research' ? 'selected' : '' %>>Research</option>
        </select>
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-subtle btn-sm">Filter</button>
      </div>
    </form>
  </div>

  <!-- Survey Cards Grid -->
  <% if (surveys.length === 0) { %>
    <div class="pc-card p-5 text-center text-muted">
      <div class="mb-2"><i class="bi bi-clipboard2-x fs-3 text-secondary"></i></div>
      <h3 class="h6 fw-bold text-dark">No surveys found</h3>
      <p class="text-secondary small mb-3">No published surveys matching your criteria are currently active.</p>
      <div>
        <a href="/surveys" class="btn btn-subtle btn-sm">Reset Filters</a>
      </div>
    </div>
  <% } else { %>
    <div class="row g-3 mb-4">
      <% surveys.forEach(survey => { %>
        <div class="col-md-4">
          <div class="pc-card pc-card-interactive h-100 p-4 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="pc-badge pc-badge-category"><%= survey.category %></span>
                <span class="pc-badge <%= survey.isOpen ? 'pc-badge-active' : 'pc-badge-closed' %>">
                  <%= survey.isOpen ? 'Open' : 'Closed' %>
                </span>
              </div>
              <h5 class="fw-semibold fs-6 mb-2">
                <a href="/surveys/<%= survey.slug %>" class="text-dark text-decoration-none">
                  <%= survey.title %>
                </a>
              </h5>
              <p class="text-secondary small mb-3">
                <%= survey.description ? (survey.description.length > 90 ? survey.description.slice(0, 90) + '...' : survey.description) : 'Multi-question academic questionnaire.' %>
              </p>
            </div>

            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
              <span class="small text-muted">
                <i class="bi bi-chat-left-dots me-1"></i> <%= survey.responses ? survey.responses.length : 0 %> responses
              </span>
              <div class="btn-group">
                <a href="/surveys/<%= survey.slug %>" class="btn btn-sm btn-primary">
                  Participate
                </a>
                <a href="/surveys/<%= survey.slug %>/results" class="btn btn-sm btn-subtle ms-1" title="View Results">
                  <i class="bi bi-graph-up"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <nav aria-label="Surveys page navigation">
        <ul class="pagination pagination-sm justify-content-center">
          <% for (let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= p === currentPage ? 'active' : '' %>">
              <a class="page-link" href="/surveys?page=<%= p %>&category=<%= category %>&search=<%= search %>"><%= p %></a>
            </li>
          <% } %>
        </ul>
      </nav>
    <% } %>
  <% } %>
</main>

<%- include('../../layouts/footer') %>
