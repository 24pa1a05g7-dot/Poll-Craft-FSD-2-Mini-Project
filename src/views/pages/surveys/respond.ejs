<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="pc-card p-4 p-md-5">
        <!-- Top Metadata -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
          <div class="d-flex align-items-center gap-2">
            <span class="pc-badge pc-badge-category"><%= survey.category %></span>
            <span class="pc-badge <%= survey.isOpen ? 'pc-badge-active' : 'pc-badge-closed' %>">
              <%= survey.isOpen ? 'Active Survey' : 'Closed' %>
            </span>
          </div>
          <button class="btn btn-subtle btn-sm btn-copy-link" data-url="<%= appUrl %>/surveys/<%= survey.slug %>">
            <i class="bi bi-share me-1"></i> Share Survey
          </button>
        </div>

        <h1 class="h4 fw-bold text-dark mb-2"><%= survey.title %></h1>
        <% if (survey.description) { %>
          <p class="text-secondary small mb-4 leading-relaxed"><%= survey.description %></p>
        <% } %>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger py-2 small border-0 mb-4" role="alert">
            <ul class="mb-0 ps-3">
              <% errors.forEach(err => { %>
                <li><%= err %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <% if (hasResponded) { %>
          <div class="pc-card bg-light p-4 text-center mb-4">
            <i class="bi bi-check-circle-fill text-success fs-2 mb-2"></i>
            <h5 class="fw-bold text-dark mb-1">Response Received</h5>
            <p class="text-secondary small mb-3">You have already submitted a response to this survey. Thank you for contributing your feedback.</p>
            <div>
              <a href="/surveys/<%= survey.slug %>/results" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-graph-up me-1"></i> View Aggregate Survey Results
              </a>
            </div>
          </div>
        <% } else if (!survey.isOpen) { %>
          <div class="pc-card bg-light p-4 text-center mb-4">
            <i class="bi bi-lock-fill text-secondary fs-2 mb-2"></i>
            <h5 class="fw-bold text-dark mb-1">Survey Closed</h5>
            <p class="text-secondary small mb-3">This survey is currently closed to new responses.</p>
            <div>
              <a href="/surveys/<%= survey.slug %>/results" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-graph-up me-1"></i> View Results
              </a>
            </div>
          </div>
        <% } else if (survey.requireLogin && !isAuthenticated) { %>
          <div class="pc-card bg-light p-4 text-center mb-4">
            <i class="bi bi-shield-exclamation text-warning fs-2 mb-2"></i>
            <h5 class="fw-bold text-dark mb-1">Sign-In Required</h5>
            <p class="text-secondary small mb-3">You must be logged in to access and respond to this survey.</p>
            <div class="d-flex justify-content-center gap-2">
              <a href="/auth/login" class="btn btn-primary btn-sm px-4">Sign In</a>
              <a href="/auth/register" class="btn btn-subtle btn-sm px-4">Register</a>
            </div>
          </div>
        <% } else if (!survey.questions || survey.questions.length === 0) { %>
          <div class="pc-card bg-light text-center py-4 text-muted small">
            This survey has no questions configured yet.
          </div>
        <% } else { %>
          <!-- Questionnaire Response Form -->
          <form action="/surveys/<%= survey.slug %>/respond" method="POST" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="d-flex flex-column gap-3 mb-4">
              <% survey.questions.forEach((q, idx) => { %>
                <div class="p-3 border rounded-2 bg-light">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <label class="form-label fw-semibold text-dark fs-6 mb-0">
                      <%= idx + 1 %>. <%= q.questionText %>
                      <% if (q.isRequired) { %>
                        <span class="text-danger" title="Required">*</span>
                      <% } %>
                    </label>
                  </div>
                  <% if (q.helpText) { %>
                    <div class="small text-muted mb-3"><%= q.helpText %></div>
                  <% } %>

                  <!-- Question Renderers based on Type -->
                  <% if (q.questionType === 'single_choice') { %>
                    <div class="d-flex flex-column gap-2">
                      <% q.options.forEach(opt => { %>
                        <div class="pc-vote-option p-3 border rounded-2 bg-white d-flex align-items-center">
                          <input class="form-check-input me-3 my-0" type="radio" name="q_<%= q.id %>" id="opt_<%= opt.id %>" value="<%= opt.id %>" <%= q.isRequired ? 'required' : '' %>>
                          <label class="form-check-label text-dark w-100 mb-0" for="opt_<%= opt.id %>" style="cursor: pointer;">
                            <%= opt.optionText %>
                          </label>
                        </div>
                      <% }) %>
                    </div>

                  <% } else if (q.questionType === 'multiple_choice') { %>
                    <div class="d-flex flex-column gap-2">
                      <% q.options.forEach(opt => { %>
                        <div class="pc-vote-option p-3 border rounded-2 bg-white d-flex align-items-center">
                          <input class="form-check-input me-3 my-0" type="checkbox" name="q_<%= q.id %>[]" id="opt_<%= opt.id %>" value="<%= opt.id %>">
                          <label class="form-check-label text-dark w-100 mb-0" for="opt_<%= opt.id %>" style="cursor: pointer;">
                            <%= opt.optionText %>
                          </label>
                        </div>
                      <% }) %>
                    </div>

                  <% } else if (q.questionType === 'short_text') { %>
                    <input type="text" class="form-control" name="q_<%= q.id %>" placeholder="Your answer..." <%= q.isRequired ? 'required' : '' %> maxlength="255">

                  <% } else if (q.questionType === 'long_text') { %>
                    <textarea class="form-control" name="q_<%= q.id %>" rows="3" placeholder="Your detailed feedback..." <%= q.isRequired ? 'required' : '' %>></textarea>

                  <% } else if (q.questionType === 'rating') { %>
                    <div class="pc-rating-bar d-flex flex-wrap gap-2 my-2">
                      <% [1, 2, 3, 4, 5].forEach(num => { %>
                        <div class="pc-rating-item">
                          <input type="radio" class="btn-check pc-rating-input" name="q_<%= q.id %>" id="rating_<%= q.id %>_<%= num %>" value="<%= num %>" <%= q.isRequired ? 'required' : '' %>>
                          <label class="pc-rating-label btn btn-outline-secondary d-flex align-items-center justify-content-center gap-1 px-3 py-2 rounded-2" for="rating_<%= q.id %>_<%= num %>">
                            <span class="fw-bold fs-6"><%= num %></span>
                            <i class="bi bi-star-fill text-warning"></i>
                          </label>
                        </div>
                      <% }) %>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mt-1" style="max-width: 320px;">
                      <span>1 = Poor</span>
                      <span>5 = Excellent</span>
                    </div>

                  <% } else if (q.questionType === 'yes_no') { %>
                    <div class="d-flex gap-4">
                      <div class="form-check">
                        <input class="form-check-input" type="radio" name="q_<%= q.id %>" id="yn_<%= q.id %>_yes" value="true" <%= q.isRequired ? 'required' : '' %>>
                        <label class="form-check-label fw-semibold text-success" for="yn_<%= q.id %>_yes">
                          <i class="bi bi-hand-thumbs-up me-1"></i> Yes
                        </label>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="radio" name="q_<%= q.id %>" id="yn_<%= q.id %>_no" value="false" <%= q.isRequired ? 'required' : '' %>>
                        <label class="form-check-label fw-semibold text-danger" for="yn_<%= q.id %>_no">
                          <i class="bi bi-hand-thumbs-down me-1"></i> No
                        </label>
                      </div>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
              <button type="submit" class="btn btn-primary px-4 py-2 fw-medium">
                Submit Completed Survey
              </button>
              <a href="/surveys/<%= survey.slug %>/results" class="text-secondary small text-decoration-none">
                <i class="bi bi-pie-chart me-1"></i> View Aggregate Results
              </a>
            </div>
          </form>
        <% } %>

        <div class="pt-3 border-top text-muted small mt-4">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
              <i class="bi bi-person me-1"></i> Organized by <%= survey.creator ? survey.creator.name : 'Faculty / Staff' %>
            </span>
            <span>
              <% if (survey.allowAnonymous) { %>
                <i class="bi bi-shield-check text-success me-1"></i> Anonymous response mode
              <% } else { %>
                <i class="bi bi-person-badge text-primary me-1"></i> Verified user response
              <% } %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
