<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card p-4 p-md-5 border-0 shadow-sm rounded-4 bg-white">
        <!-- Top Metadata -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-success border"><%= survey.category %></span>
            <span class="badge <%= survey.isOpen ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %>">
              <%= survey.isOpen ? 'Active Survey' : 'Closed' %>
            </span>
          </div>
          <button class="btn btn-outline-secondary btn-sm rounded-pill btn-copy-link" data-url="<%= appUrl %>/surveys/<%= survey.slug %>">
            <i class="bi bi-share me-1"></i> Share Survey
          </button>
        </div>

        <h1 class="h3 fw-bold text-dark mb-2"><%= survey.title %></h1>
        <% if (survey.description) { %>
          <p class="text-secondary mb-4 leading-relaxed"><%= survey.description %></p>
        <% } %>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger py-2 small border-0 mb-4" role="alert">
            <ul class="mb-0 ps-3">
              <% errors.forEach(err => { %>
                <li><%= err %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <% if (hasResponded) { %>
          <div class="card bg-success-subtle border-0 p-4 text-center rounded-3 mb-4">
            <i class="bi bi-check-circle-fill text-success display-6 mb-2"></i>
            <h5 class="fw-bold text-success mb-1">Response Received!</h5>
            <p class="text-secondary small mb-3">You have already submitted a response to this survey. Thank you for contributing your feedback.</p>
            <div>
              <a href="/surveys/<%= survey.slug %>/results" class="btn btn-success text-white px-4 rounded-pill">
                <i class="bi bi-graph-up me-1"></i> View Aggregate Survey Results
              </a>
            </div>
          </div>
        <% } else if (!survey.isOpen) { %>
          <div class="card bg-secondary-subtle border-0 p-4 text-center rounded-3 mb-4">
            <i class="bi bi-lock-fill text-secondary display-6 mb-2"></i>
            <h5 class="fw-bold text-dark mb-1">Survey Closed</h5>
            <p class="text-secondary small mb-3">This survey is currently closed to new responses.</p>
            <div>
              <a href="/surveys/<%= survey.slug %>/results" class="btn btn-primary px-4 rounded-pill">
                <i class="bi bi-graph-up me-1"></i> View Results
              </a>
            </div>
          </div>
        <% } else if (survey.requireLogin && !isAuthenticated) { %>
          <div class="card bg-warning-subtle border-0 p-4 text-center rounded-3 mb-4">
            <i class="bi bi-shield-exclamation text-warning display-6 mb-2"></i>
            <h5 class="fw-bold text-dark mb-1">Sign-In Required</h5>
            <p class="text-secondary small mb-3">You must be logged in to access and respond to this survey.</p>
            <div class="d-flex justify-content-center gap-2">
              <a href="/auth/login" class="btn btn-primary px-4 rounded-pill">Sign In</a>
              <a href="/auth/register" class="btn btn-outline-secondary px-4 rounded-pill">Register</a>
            </div>
          </div>
        <% } else if (!survey.questions || survey.questions.length === 0) { %>
          <div class="alert alert-info border-0 rounded-3 text-center py-4">
            This survey has no questions configured yet.
          </div>
        <% } else { %>
          <!-- Questionnaire Response Form -->
          <form action="/surveys/<%= survey.slug %>/respond" method="POST" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="d-flex flex-column gap-4 mb-4">
              <% survey.questions.forEach((q, idx) => { %>
                <div class="card p-4 border rounded-3 bg-light">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <label class="form-label fw-bold text-dark fs-6 mb-0">
                      <%= idx + 1 %>. <%= q.questionText %>
                      <% if (q.isRequired) { %>
                        <span class="text-danger" title="Required">*</span>
                      <% } %>
                    </label>
                  </div>
                  <% if (q.helpText) { %>
                    <div class="small text-muted mb-3"><%= q.helpText %></div>
                  <% } %>

                  <!-- Question Renderers based on Type -->
                  <% if (q.questionType === 'single_choice') { %>
                    <div class="d-flex flex-column gap-2">
                      <% q.options.forEach(opt => { %>
                        <div class="form-check">
                          <input class="form-check-input" type="radio" name="q_<%= q.id %>" id="opt_<%= opt.id %>" value="<%= opt.id %>" <%= q.isRequired ? 'required' : '' %>>
                          <label class="form-check-label" for="opt_<%= opt.id %>">
                            <%= opt.optionText %>
                          </label>
                        </div>
                      <% }) %>
                    </div>

                  <% } else if (q.questionType === 'multiple_choice') { %>
                    <div class="d-flex flex-column gap-2">
                      <% q.options.forEach(opt => { %>
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" name="q_<%= q.id %>[]" id="opt_<%= opt.id %>" value="<%= opt.id %>">
                          <label class="form-check-label" for="opt_<%= opt.id %>">
                            <%= opt.optionText %>
                          </label>
                        </div>
                      <% }) %>
                    </div>

                  <% } else if (q.questionType === 'short_text') { %>
                    <input type="text" class="form-control" name="q_<%= q.id %>" placeholder="Your answer..." <%= q.isRequired ? 'required' : '' %> maxlength="255">

                  <% } else if (q.questionType === 'long_text') { %>
                    <textarea class="form-control" name="q_<%= q.id %>" rows="4" placeholder="Your detailed feedback..." <%= q.isRequired ? 'required' : '' %>></textarea>

                  <% } else if (q.questionType === 'rating') { %>
                    <div class="rating-group">
                      <% [1, 2, 3, 4, 5].forEach(num => { %>
                        <input type="radio" class="btn-check rating-input" name="q_<%= q.id %>" id="rating_<%= q.id %>_<%= num %>" value="<%= num %>" <%= q.isRequired ? 'required' : '' %>>
                        <label class="rating-star-btn" for="rating_<%= q.id %>_<%= num %>">
                          <%= num %> <i class="bi bi-star-fill text-warning ms-1" style="font-size: 0.8rem;"></i>
                        </label>
                      <% }) %>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mt-1" style="max-width: 250px;">
                      <span>1 = Poor</span>
                      <span>5 = Excellent</span>
                    </div>

                  <% } else if (q.questionType === 'yes_no') { %>
                    <div class="d-flex gap-4">
                      <div class="form-check">
                        <input class="form-check-input" type="radio" name="q_<%= q.id %>" id="yn_<%= q.id %>_yes" value="true" <%= q.isRequired ? 'required' : '' %>>
                        <label class="form-check-label fw-semibold text-success" for="yn_<%= q.id %>_yes">
                          <i class="bi bi-hand-thumbs-up me-1"></i> Yes
                        </label>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="radio" name="q_<%= q.id %>" id="yn_<%= q.id %>_no" value="false" <%= q.isRequired ? 'required' : '' %>>
                        <label class="form-check-label fw-semibold text-danger" for="yn_<%= q.id %>_no">
                          <i class="bi bi-hand-thumbs-down me-1"></i> No
                        </label>
                      </div>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
              <button type="submit" class="btn btn-success text-white px-5 py-2 rounded-pill fw-medium">
                Submit Completed Survey
              </button>
              <a href="/surveys/<%= survey.slug %>/results" class="text-secondary small text-decoration-none">
                <i class="bi bi-pie-chart me-1"></i> View Aggregate Results
              </a>
            </div>
          </form>
        <% } %>

        <div class="pt-3 border-top text-muted small mt-4">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
              <i class="bi bi-person me-1"></i> Organized by <%= survey.creator ? survey.creator.name : 'Faculty / Staff' %>
            </span>
            <span>
              <% if (survey.allowAnonymous) { %>
                <i class="bi bi-shield-check text-success me-1"></i> Anonymous response mode
              <% } else { %>
                <i class="bi bi-person-badge text-primary me-1"></i> Verified user response
              <% } %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
