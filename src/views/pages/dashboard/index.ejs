<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <!-- Header Bar -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h4 fw-bold text-dark m-0">Dashboard</h1>
      <p class="text-secondary small m-0">Welcome back, <%= user.name %>! Manage your polls, surveys, and response metrics.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/polls/new" class="btn btn-primary btn-sm d-flex align-items-center gap-1">
        <i class="bi bi-plus-lg"></i>
        <span>New Poll</span>
      </a>
      <a href="/surveys/new" class="btn btn-subtle btn-sm d-flex align-items-center gap-1">
        <i class="bi bi-clipboard-plus"></i>
        <span>New Survey</span>
      </a>
    </div>
  </div>

  <!-- Stat Summary Widgets -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="pc-stat-box">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="pc-stat-value"><%= stats.totalPolls %></div>
            <div class="pc-stat-label">Polls Authored</div>
          </div>
          <div class="text-primary fs-4">
            <i class="bi bi-pie-chart"></i>
          </div>
        </div>
        <div class="mt-2 small text-secondary">
          <span class="text-success fw-medium"><%= stats.activePolls %> Active</span> · <span><%= stats.closedPolls %> Closed</span>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="pc-stat-box">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="pc-stat-value"><%= stats.totalSurveys %></div>
            <div class="pc-stat-label">Surveys Authored</div>
          </div>
          <div class="text-success fs-4">
            <i class="bi bi-card-checklist"></i>
          </div>
        </div>
        <div class="mt-2 small text-secondary">
          Multi-question questionnaires
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="pc-stat-box">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="pc-stat-value"><%= stats.totalVotes %></div>
            <div class="pc-stat-label">Votes Received</div>
          </div>
          <div class="text-primary fs-4">
            <i class="bi bi-check2-circle"></i>
          </div>
        </div>
        <div class="mt-2 small text-secondary">
          Across your active polls
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="pc-stat-box">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="pc-stat-value"><%= stats.totalSurveyResponses %></div>
            <div class="pc-stat-label">Survey Submissions</div>
          </div>
          <div class="text-warning fs-4">
            <i class="bi bi-chat-left-dots"></i>
          </div>
        </div>
        <div class="mt-2 small text-secondary">
          Detailed response records
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- User's Polls -->
    <div class="col-lg-6">
      <div class="pc-card p-4 h-100">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h6 fw-bold text-dark m-0 d-flex align-items-center gap-2">
            <i class="bi bi-pie-chart text-primary"></i> My Recent Polls
          </h2>
          <a href="/polls/new" class="btn btn-sm btn-subtle py-1 px-2 small">
            <i class="bi bi-plus"></i> New
          </a>
        </div>

        <% if (!stats.recentPolls || stats.recentPolls.length === 0) { %>
          <div class="text-center py-5 text-muted">
            <div class="mb-2"><i class="bi bi-inbox fs-3 text-secondary"></i></div>
            <p class="small mb-2">You haven't created any polls yet.</p>
            <a href="/polls/new" class="btn btn-sm btn-primary">Create Your First Poll</a>
          </div>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% stats.recentPolls.forEach(poll => { %>
              <div class="list-group-item px-0 py-3 border-bottom">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <div class="fw-semibold">
                    <a href="/polls/<%= poll.slug %>" class="text-dark text-decoration-none">
                      <%= poll.title %>
                    </a>
                  </div>
                  <span class="pc-badge <%= poll.isOpen ? 'pc-badge-active' : 'pc-badge-closed' %>">
                    <%= poll.status %>
                  </span>
                </div>
                <div class="d-flex justify-content-between align-items-center text-muted small mt-2">
                  <div>
                    <span class="me-2"><i class="bi bi-tag me-1"></i> <%= poll.category %></span>
                    <span><i class="bi bi-people me-1"></i> <%= poll.votes ? poll.votes.length : 0 %> votes</span>
                  </div>
                  <div class="btn-group btn-group-sm">
                    <a href="/polls/<%= poll.slug %>/results" class="btn btn-subtle" title="Results & Analytics">
                      <i class="bi bi-graph-up"></i>
                    </a>
                    <a href="/polls/<%= poll.slug %>/edit" class="btn btn-subtle" title="Edit Poll Settings">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/polls/<%= poll.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this poll? All votes will be removed.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-subtle text-danger" title="Delete Poll">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- User's Surveys -->
    <div class="col-lg-6">
      <div class="pc-card p-4 h-100">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h6 fw-bold text-dark m-0 d-flex align-items-center gap-2">
            <i class="bi bi-card-checklist text-success"></i> My Recent Surveys
          </h2>
          <a href="/surveys/new" class="btn btn-sm btn-subtle py-1 px-2 small">
            <i class="bi bi-plus"></i> New
          </a>
        </div>

        <% if (!stats.recentSurveys || stats.recentSurveys.length === 0) { %>
          <div class="text-center py-5 text-muted">
            <div class="mb-2"><i class="bi bi-inbox fs-3 text-secondary"></i></div>
            <p class="small mb-2">You haven't created any surveys yet.</p>
            <a href="/surveys/new" class="btn btn-sm btn-primary">Create Your First Survey</a>
          </div>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% stats.recentSurveys.forEach(survey => { %>
              <div class="list-group-item px-0 py-3 border-bottom">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <div class="fw-semibold">
                    <a href="/surveys/<%= survey.slug %>" class="text-dark text-decoration-none">
                      <%= survey.title %>
                    </a>
                  </div>
                  <span class="pc-badge <%= survey.status === 'published' ? 'pc-badge-active' : (survey.status === 'closed' ? 'pc-badge-closed' : 'pc-badge-draft') %>">
                    <%= survey.status %>
                  </span>
                </div>
                <div class="d-flex justify-content-between align-items-center text-muted small mt-2">
                  <div>
                    <span class="me-2"><i class="bi bi-tag me-1"></i> <%= survey.category %></span>
                    <span><i class="bi bi-chat-left-text me-1"></i> <%= survey.responses ? survey.responses.length : 0 %> responses</span>
                  </div>
                  <div class="btn-group btn-group-sm">
                    <a href="/surveys/<%= survey.id %>/builder" class="btn btn-subtle" title="Question Builder">
                      <i class="bi bi-sliders"></i>
                    </a>
                    <a href="/surveys/<%= survey.slug %>/results" class="btn btn-subtle" title="Analytics">
                      <i class="bi bi-graph-up"></i>
                    </a>
                    <a href="/surveys/<%= survey.id %>/export/csv" class="btn btn-subtle" title="Download CSV">
                      <i class="bi bi-download"></i>
                    </a>
                    <form action="/surveys/<%= survey.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this survey and all responses?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-subtle text-danger" title="Delete Survey">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
