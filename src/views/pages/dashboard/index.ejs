<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5">
  <!-- Header Bar -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold text-dark m-0">Dashboard</h1>
      <p class="text-secondary small m-0">Welcome back, <%= user.name %>! Manage your active polls, surveys, and responses.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/polls/new" class="btn btn-primary rounded-pill btn-sm px-3 py-2">
        <i class="bi bi-plus-lg me-1"></i> New Poll
      </a>
      <a href="/surveys/new" class="btn btn-success text-white rounded-pill btn-sm px-3 py-2">
        <i class="bi bi-clipboard2-plus me-1"></i> New Survey
      </a>
    </div>
  </div>

  <!-- Stat Cards -->
  <div class="row g-3 mb-5">
    <div class="col-sm-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="stat-number text-primary"><%= stats.totalPolls %></div>
            <div class="text-muted small fw-medium">Polls Created</div>
          </div>
          <div class="stat-icon bg-primary-subtle text-primary">
            <i class="bi bi-bar-chart-line"></i>
          </div>
        </div>
        <div class="mt-2 small text-secondary">
          <span class="text-success fw-medium"><%= stats.activePolls %> Active</span> · <span><%= stats.closedPolls %> Closed</span>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="stat-number text-success"><%= stats.totalSurveys %></div>
            <div class="text-muted small fw-medium">Surveys Created</div>
          </div>
          <div class="stat-icon bg-success-subtle text-success">
            <i class="bi bi-clipboard2-check"></i>
          </div>
        </div>
        <div class="mt-2 small text-secondary">
          Multi-question questionnaires
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="stat-number" style="color: #6366f1;"><%= stats.totalVotes %></div>
            <div class="text-muted small fw-medium">Total Votes Cast</div>
          </div>
          <div class="stat-icon bg-light text-primary">
            <i class="bi bi-check2-circle"></i>
          </div>
        </div>
        <div class="mt-2 small text-secondary">
          Across all your active polls
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="stat-number text-warning"><%= stats.totalSurveyResponses %></div>
            <div class="text-muted small fw-medium">Survey Responses</div>
          </div>
          <div class="stat-icon bg-warning-subtle text-warning">
            <i class="bi bi-chat-left-dots"></i>
          </div>
        </div>
        <div class="mt-2 small text-secondary">
          Individual submissions recorded
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-5">
    <!-- My Polls -->
    <div class="col-lg-6">
      <div class="card card-custom p-4 h-100">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h5 fw-bold text-dark m-0 d-flex align-items-center gap-2">
            <i class="bi bi-bar-chart-fill text-primary"></i> My Recent Polls
          </h2>
          <a href="/polls/new" class="btn btn-sm btn-outline-primary rounded-pill">
            <i class="bi bi-plus"></i> New
          </a>
        </div>

        <% if (!stats.recentPolls || stats.recentPolls.length === 0) { %>
          <div class="text-center py-4 text-muted">
            <p class="small mb-2">You haven't created any polls yet.</p>
            <a href="/polls/new" class="btn btn-sm btn-primary">Create Your First Poll</a>
          </div>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% stats.recentPolls.forEach(poll => { %>
              <div class="list-group-item px-0 py-3">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <div class="fw-semibold">
                    <a href="/polls/<%= poll.slug %>" class="text-dark text-decoration-none hover-primary">
                      <%= poll.title %>
                    </a>
                  </div>
                  <span class="badge <%= poll.isOpen ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %> small">
                    <%= poll.status %>
                  </span>
                </div>
                <div class="d-flex justify-content-between align-items-center text-muted small mt-2">
                  <div>
                    <span class="me-2"><i class="bi bi-tag me-1"></i> <%= poll.category %></span>
                    <span><i class="bi bi-check2-square me-1"></i> <%= poll.votes ? poll.votes.length : 0 %> votes</span>
                  </div>
                  <div class="btn-group btn-group-sm">
                    <a href="/polls/<%= poll.slug %>/results" class="btn btn-outline-secondary" title="View Results & Analytics">
                      <i class="bi bi-graph-up"></i>
                    </a>
                    <a href="/polls/<%= poll.slug %>/edit" class="btn btn-outline-secondary" title="Edit Settings">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/polls/<%= poll.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this poll? All votes will be permanently removed.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-outline-danger" title="Delete Poll">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- My Surveys -->
    <div class="col-lg-6">
      <div class="card card-custom p-4 h-100">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h5 fw-bold text-dark m-0 d-flex align-items-center gap-2">
            <i class="bi bi-clipboard2-data-fill text-success"></i> My Recent Surveys
          </h2>
          <a href="/surveys/new" class="btn btn-sm btn-outline-success rounded-pill">
            <i class="bi bi-plus"></i> New
          </a>
        </div>

        <% if (!stats.recentSurveys || stats.recentSurveys.length === 0) { %>
          <div class="text-center py-4 text-muted">
            <p class="small mb-2">You haven't created any surveys yet.</p>
            <a href="/surveys/new" class="btn btn-sm btn-success text-white">Create Your First Survey</a>
          </div>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% stats.recentSurveys.forEach(survey => { %>
              <div class="list-group-item px-0 py-3">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <div class="fw-semibold">
                    <a href="/surveys/<%= survey.slug %>" class="text-dark text-decoration-none">
                      <%= survey.title %>
                    </a>
                  </div>
                  <span class="badge <%= survey.status === 'published' ? 'bg-success-subtle text-success' : (survey.status === 'closed' ? 'bg-secondary-subtle text-secondary' : 'bg-warning-subtle text-warning') %> small">
                    <%= survey.status %>
                  </span>
                </div>
                <div class="d-flex justify-content-between align-items-center text-muted small mt-2">
                  <div>
                    <span class="me-2"><i class="bi bi-folder me-1"></i> <%= survey.category %></span>
                    <span><i class="bi bi-people me-1"></i> <%= survey.responses ? survey.responses.length : 0 %> responses</span>
                  </div>
                  <div class="btn-group btn-group-sm">
                    <a href="/surveys/<%= survey.id %>/builder" class="btn btn-outline-secondary" title="Survey Question Builder">
                      <i class="bi bi-sliders"></i> Builder
                    </a>
                    <a href="/surveys/<%= survey.slug %>/results" class="btn btn-outline-secondary" title="Analytics & Charts">
                      <i class="bi bi-pie-chart"></i>
                    </a>
                    <a href="/surveys/<%= survey.id %>/export/csv" class="btn btn-outline-secondary" title="Export CSV">
                      <i class="bi bi-download"></i> CSV
                    </a>
                    <form action="/surveys/<%= survey.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this survey and all responses?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-outline-danger" title="Delete Survey">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
