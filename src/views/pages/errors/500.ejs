<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="pc-card p-5">
        <div class="display-3 text-warning fw-bold mb-3">500</div>
        <h2 class="h4 fw-bold mb-2"><%= title || 'Internal Server Error' %></h2>
        <p class="text-secondary small mb-4 leading-relaxed">
          <%= message || 'An unexpected problem occurred while processing this request.' %>
        </p>

        <% if (typeof error !== 'undefined' && error && error.stack) { %>
          <div class="text-start bg-dark text-light p-3 rounded-2 mb-4 overflow-auto font-monospace small" style="max-height: 250px;">
            <pre class="m-0"><code><%= error.stack %></code></pre>
          </div>
        <% } %>

        <div class="d-flex justify-content-center flex-wrap gap-2">
          <a href="/dashboard" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
          </a>
          <a href="/" class="btn btn-subtle btn-sm px-3">
            <i class="bi bi-house me-1"></i> Home
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
