<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card p-5 shadow-sm border-0 rounded-4">
        <div class="display-1 text-warning fw-bold mb-3">500</div>
        <h2 class="h3 fw-semibold mb-3"><%= title || 'Internal Server Error' %></h2>
        <p class="text-secondary mb-4 leading-relaxed">
          <%= message || 'An unexpected problem occurred while processing this request.' %>
        </p>

        <% if (typeof error !== 'undefined' && error && error.stack) { %>
          <div class="text-start bg-dark text-light p-3 rounded-3 mb-4 overflow-auto font-monospace small" style="max-height: 250px;">
            <pre class="m-0"><code><%= error.stack %></code></pre>
          </div>
        <% } %>

        <div class="d-flex justify-content-center gap-3">
          <a href="/dashboard" class="btn btn-primary px-4 py-2">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
          </a>
          <a href="/" class="btn btn-outline-secondary px-4 py-2">
            <i class="bi bi-house me-1"></i> Home
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
