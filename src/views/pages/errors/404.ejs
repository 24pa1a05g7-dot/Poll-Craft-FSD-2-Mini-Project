<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="pc-card p-5">
        <div class="display-3 text-primary fw-bold mb-3">404</div>
        <h2 class="h4 fw-bold mb-2"><%= title || 'Page Not Found' %></h2>
        <p class="text-secondary small mb-4 leading-relaxed">
          <%= message || 'The poll, survey, or page you are looking for does not exist or may have been unlisted.' %>
        </p>
        <div class="d-flex justify-content-center flex-wrap gap-2">
          <a href="/polls" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-bar-chart-line me-1"></i> Browse Polls
          </a>
          <a href="/surveys" class="btn btn-subtle btn-sm px-3">
            <i class="bi bi-clipboard2-check me-1"></i> Browse Surveys
          </a>
          <a href="/" class="btn btn-subtle btn-sm px-3">
            <i class="bi bi-house me-1"></i> Home
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
