<%- include('../../layouts/header') %>
<%- include('../../layouts/navbar') %>

<main class="container my-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card p-5 shadow-sm border-danger border-opacity-25 rounded-4">
        <div class="display-1 text-danger fw-bold mb-3">403</div>
        <h2 class="h3 fw-semibold mb-3"><%= title || 'Access Forbidden' %></h2>
        <p class="text-secondary mb-4 leading-relaxed">
          <%= message || 'You do not have permission to view or execute actions on this resource.' %>
        </p>
        <div class="d-flex justify-content-center gap-3">
          <a href="/dashboard" class="btn btn-primary px-4 py-2">
            <i class="bi bi-speedometer2 me-1"></i> Return to Dashboard
          </a>
          <a href="/" class="btn btn-outline-secondary px-4 py-2">
            <i class="bi bi-house me-1"></i> Home
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../layouts/footer') %>
